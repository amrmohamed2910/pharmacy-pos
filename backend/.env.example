# إعدادات اختيارية — انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/pharmacy_db?charset=utf8mb4
# JWT_SECRET=ضع-هنا-مفتاحًا-عشوائيًا-طويلًا
# TOKEN_EXPIRE_MINUTES=720
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LOW_STOCK_THRESHOLD=10
# EXPIRY_WARNING_DAYS=90
# DEFAULT_CURRENCY=ج.م
#
# --- قاعدة بيانات سحابية (Aiven MySQL) ---
# مثال DATABASE_URL من لوحة Aiven:
# DATABASE_URL=mysql+pymysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?charset=utf8mb4
# اتصال مشفّر بدون التحقق من الشهادة (الأسهل):
# DATABASE_SSL_VERIFY=false
# أو تحقق باستخدام شهادة Aiven CA (الأكثر أمانًا):
# DATABASE_SSL_CA=C:/path/to/aiven-ca.pem
# DATABASE_SSL_VERIFY=true
